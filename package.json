  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "generate": "node src/generatePlan.js",
    "test:e2e": "playwright test",
    "test:e2e:report": "playwright test && npm run allure:generate",
    "allure:generate": "node src/cleanAllureReport.js && allure awesome ./allure-results --output ./allure-report --theme dark --report-name \"Ritual Ledger QA Report\" --logo /assets/allure-logo.svg && node src/themeAllureReport.js",
    "allure:open": "allure open ./allure-report",
    "docker:build": "node src/ensureAllureReportForDocker.js && docker compose build"
  },
